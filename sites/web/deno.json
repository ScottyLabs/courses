{
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "vite dev",
    "dev:mock": "MOCK_API=1 vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && node scripts/check.mjs",
    "test": "svelte-kit sync && deno test --allow-read --allow-write --allow-env 'src/lib/**/*.test.ts' 'dev/**/*.test.ts'",
    "generate-api": "deno run --allow-read --allow-write --allow-env --allow-sys dev/generate-api.ts"
  },
  "compilerOptions": {
    "lib": ["deno.window", "dom", "dom.iterable", "esnext"]
  }
}
