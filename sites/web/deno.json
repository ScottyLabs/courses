{
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && node scripts/check.mjs",
    "test": "svelte-kit sync && deno test --unstable-sloppy-imports --allow-read --allow-env --allow-sys=cpus src/lib/*.test.ts",
    "test:browser": "vite --config tests/vite.config.ts --host 127.0.0.1 --port 5176",
    "generate-api": "openapi-typescript http://localhost:3002/api/openapi.json -o src/lib/api.d.ts"
  }
}
